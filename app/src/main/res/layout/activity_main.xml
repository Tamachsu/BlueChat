<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/white"
        tools:layout_editor_absoluteX="56dp"
        tools:layout_editor_absoluteY="54dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:orientation="horizontal"
            android:padding="15dp">

            <TextView
                android:id="@+id/txtSite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:layout_weight="1"
                android:text="BlueChat"
                android:textSize="20dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtQuestao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Como te Chamas?"
                android:textColor="@color/black"
                android:textSize="24dp" />

            <TextView
                android:id="@+id/txtDescricao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A alcunha que os outros"
                android:textColor="@color/grey"
                android:textSize="16dp" />

            <TextView
                android:id="@+id/txtDescricao2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" vão ver na conversa"
                android:textColor="@color/grey"
                android:textSize="16dp" />

            <EditText
                android:id="@+id/etAlcunha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:ems="13"
                android:hint="Alcunha"
                android:inputType="text" />

            <TextView
                android:id="@+id/txtInformação"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardada em SharedPreferences" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="270dp"
                android:paddingStart="40dp"
                android:paddingEnd="40dp">

                <Button
                    android:id="@+id/btnContinuar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:padding="15dp"
                    android:text="Continuar" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>